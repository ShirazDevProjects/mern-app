# ==========================================
# VPS & Traefik Configuration
# ==========================================

# Domain name (e.g. example.com or app.example.com)
# When testing locally or without a domain, leave as localhost or your VPS IP
DOMAIN=localhost

# Name of the external Docker network that your existing Traefik container uses
# (Common names: traefik-network, proxy, web, traefik_default)
TRAEFIK_NETWORK=traefik-network

# Name of the certificate resolver configured in your existing Traefik instance
# (Common names: myresolver, letsencrypt, le, default)
TRAEFIK_CERTRESOLVER=myresolver

# ==========================================
# Database Configuration
# ==========================================

# MongoDB connection string
# Defaults to the internal container named 'mongo' on port 27017
MONGODB_URI=mongodb://mongo:27017/mernapp

# PostgreSQL connection string (optional, leave empty if not used)
POSTGRES_URI=
