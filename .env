# Domain name (change to your real domain when ready)
DOMAIN=srv1011002.hstgr.cloud

# Name of the external Docker network that your existing Traefik container uses
TRAEFIK_NETWORK=traefik-network

# Name of the certificate resolver in your existing Traefik configuration
TRAEFIK_CERTRESOLVER=myresolver

# Database connections
MONGODB_URI=mongodb://mongo:27017/mernapp
POSTGRES_URI=
